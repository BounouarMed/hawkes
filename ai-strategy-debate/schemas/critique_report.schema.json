{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["scenario_id","round","critic_agent","target_agent","strongest_point","top_weaknesses","corrections","verdict"],
  "properties": {
    "scenario_id": {"type":"string"},
    "round": {"type":"integer"},
    "critic_agent": {"type":"string"},
    "target_agent": {"type":"string"},
    "strongest_point": {"type":"string"},
    "top_weaknesses": {"type":"array","minItems":1,"maxItems":4,"items":{"type":"string"}},
    "corrections": {"type":"array","items":{"type":"string"}},
    "verdict": {"type":"string","enum":["pass","revise","block"]},
    "on_demand_requests": {"type":"array","items":{"type":"object"}}
  }
}
